# Server
PORT=3000

# The base URL used to build short URLs like http://localhost:3000/abc123
# In production set this to your real domain, e.g. https://shorty.example.com
BASE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/urlshortener

# Redis connection string
# If Redis has a password it looks like: redis://:mypassword@localhost:6379
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds (86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Rate limiting: how many requests per window
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Analytics outbox settings
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_FLUSH_INTERVAL_SECONDS=5

# How long an Idempotency-Key result is cached in Redis (in seconds)
IDEMPOTENCY_KEY_TTL_SECONDS=3600

# PostgreSQL pool tuning
DATABASE_MAX_CONNECTIONS=20
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Short code obfuscation: XORed with the id before Base62.
# Change this once at deploy; changing it later makes new codes map differently.
SHORT_CODE_SALT=0x5f3759df

# Redis pool
REDIS_POOL_MAX_SIZE=16

# Trust X-Forwarded-For from N proxies (0 = never trust, 1 = behind one load balancer)
TRUSTED_PROXY_COUNT=0

# ----- Used by docker-compose.prod.yml only -----
# Set a strong password for your deployed Redis and PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shorty
REDIS_PASSWORD=change-me
